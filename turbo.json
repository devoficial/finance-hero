{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["FINANCE_HERO_DATABASE_KEY", "FINANCE_HERO_DATA_DIR", "FINANCE_HERO_HOST", "FINANCE_HERO_PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
