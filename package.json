{
  "name": "finance-hero",
  "version": "0.1.0",
  "description": "Finance Hero is a private, local-first personal finance PWA for one household. It combines a unified accounting ledger with familiar tracker views for liabilities, daily expenses, and home construction.",
  "scripts": {
    "test": "turbo test",
    "dev": "turbo dev",
    "setup:local": "node scripts/local-control.mjs setup",
    "start:local": "node scripts/local-control.mjs start",
    "stop:local": "node scripts/local-control.mjs stop",
    "status:local": "node scripts/local-control.mjs status",
    "logs:local": "node scripts/local-control.mjs logs",
    "backup:local": "node scripts/local-control.mjs backup",
    "verify-backup:local": "node scripts/local-control.mjs verify-backup",
    "stage-restore:local": "node scripts/local-control.mjs stage-restore",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devoficial/finance-hero.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2"
}
