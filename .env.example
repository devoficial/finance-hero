FINANCE_HERO_HOST=127.0.0.1
FINANCE_HERO_PORT=4317
FINANCE_HERO_DATA_DIR=./data

# Development only. Production reads the database key from macOS Keychain.
FINANCE_HERO_DATABASE_KEY=replace-with-at-least-32-random-characters

# Optional Gmail statement discovery. Use a Google OAuth Web client and restrict
# access to the single Finance Hero owner email.
FINANCE_HERO_GOOGLE_CLIENT_ID=
FINANCE_HERO_GOOGLE_CLIENT_SECRET=
FINANCE_HERO_GOOGLE_OWNER_EMAIL=
FINANCE_HERO_GOOGLE_REDIRECT_URI=http://127.0.0.1:4317/api/v1/gmail/oauth/callback
